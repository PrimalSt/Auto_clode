{
  "name": "autogenerator-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Окно Autogenerator: React-интерфейс поверх локального сервера",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api": "uv run python -m autogenerator.server --openapi openapi.json && openapi-typescript openapi.json --default-non-nullable false -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/modals": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "^5.5.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "openapi-typescript-helpers": "^0.1.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
