{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autogenerator",
  "version": "0.1.0",
  "identifier": "ru.autogenerator.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Autogenerator",
    "shortDescription": "Автогенератор отчётных презентаций",
